<% content_for :title, "Sign in" %>
<div class="auth">
  <h1 style="font-size:26px">Sign in</h1>
  <%= form_with url: session_path, class: "stack" do |f| %>
    <div class="field"><%= f.label :email_address, "Email" %><%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %></div>
    <div class="field"><%= f.label :password %><%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %></div>
    <%= f.submit "Sign in", class: "btn primary" %>
  <% end %>
  <p class="muted">New here? <%= link_to "Create an account", new_registration_path %>, or <%= button_to "continue as a guest", demo_session_path, class: "btn small ghost", form: { style: "display:inline" } %></p>
</div>
